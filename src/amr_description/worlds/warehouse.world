<?xml version="1.0"?>

<sdf version="1.6">

  <world name="warehouse_world">

    <!-- ============================== -->
    <!-- PHYSICS                        -->
    <!-- ============================== -->

    <physics name="default_physics"
             default="0"
             type="ode">

      <gravity>0 0 -9.81</gravity>

    </physics>


    <!-- ============================== -->
    <!-- WORLD LIGHTING                  -->
    <!-- ============================== -->

    <include>
      <uri>model://sun</uri>
    </include>


    <!-- ============================== -->
    <!-- GROUND                          -->
    <!-- ============================== -->

    <include>
      <uri>model://ground_plane</uri>
    </include>


    <!-- ============================== -->
    <!-- BOUNDARY WALLS                  -->
    <!-- ============================== -->

    <!-- North wall -->

    <model name="north_wall">
      <static>true</static>

      <pose>0 7.5 1 0 0 0</pose>

      <link name="link">

        <collision name="collision">
          <geometry>
            <box>
              <size>20 0.3 2</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>20 0.3 2</size>
            </box>
          </geometry>

          <material>
            <ambient>0.6 0.6 0.6 1</ambient>
          </material>

        </visual>

      </link>

    </model>


    <!-- South wall -->

    <model name="south_wall">
      <static>true</static>

      <pose>0 -7.5 1 0 0 0</pose>

      <link name="link">

        <collision name="collision">
          <geometry>
            <box>
              <size>20 0.3 2</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>20 0.3 2</size>
            </box>
          </geometry>

          <material>
            <ambient>0.6 0.6 0.6 1</ambient>
          </material>

        </visual>

      </link>

    </model>


    <!-- East wall -->

    <model name="east_wall">
      <static>true</static>

      <pose>10 0 1 0 0 0</pose>

      <link name="link">

        <collision name="collision">
          <geometry>
            <box>
              <size>0.3 15 2</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>0.3 15 2</size>
            </box>
          </geometry>

          <material>
            <ambient>0.6 0.6 0.6 1</ambient>
          </material>

        </visual>

      </link>

    </model>


    <!-- West wall -->

    <model name="west_wall">
      <static>true</static>

      <pose>-10 0 1 0 0 0</pose>

      <link name="link">

        <collision name="collision">
          <geometry>
            <box>
              <size>0.3 15 2</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>0.3 15 2</size>
            </box>
          </geometry>

          <material>
            <ambient>0.6 0.6 0.6 1</ambient>
          </material>

        </visual>

      </link>

    </model>


    <!-- ================================= -->
    <!-- WAREHOUSE SHELVES                  -->
    <!-- ================================= -->

    <!-- Shelf Row 1 -->

    <model name="shelf_1">
      <static>true</static>

      <pose>-5 -3 1 0 0 0</pose>

      <link name="link">

        <collision name="collision">
          <geometry>
            <box>
              <size>1.2 4 2</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>1.2 4 2</size>
            </box>
          </geometry>

          <material>
            <ambient>0.3 0.3 0.3 1</ambient>
          </material>

        </visual>

      </link>

    </model>


    <model name="shelf_2">
      <static>true</static>

      <pose>0 -3 1 0 0 0</pose>

      <link name="link">

        <collision name="collision">
          <geometry>
            <box>
              <size>1.2 4 2</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>1.2 4 2</size>
            </box>

          </geometry>

          <material>
            <ambient>0.3 0.3 0.3 1</ambient>
          </material>

        </visual>

      </link>

    </model>


    <model name="shelf_3">
      <static>true</static>

      <pose>5 -3 1 0 0 0</pose>

      <link name="link">

        <collision name="collision">
          <geometry>
            <box>
              <size>1.2 4 2</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>1.2 4 2</size>
            </box>
          </geometry>

          <material>
            <ambient>0.3 0.3 0.3 1</ambient>
          </material>

        </visual>

      </link>

    </model>


    <!-- Shelf Row 2 -->

    <model name="shelf_4">
      <static>true</static>

      <pose>-5 3 1 0 0 0</pose>

      <link name="link">

        <collision name="collision">
          <geometry>
            <box>
              <size>1.2 4 2</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>1.2 4 2</size>
            </box>
          </geometry>

          <material>
            <ambient>0.3 0.3 0.3 1</ambient>
          </material>

        </visual>

      </link>

    </model>


    <model name="shelf_5">
      <static>true</static>

      <pose>0 3 1 0 0 0</pose>

      <link name="link">

        <collision name="collision">
          <geometry>
            <box>
              <size>1.2 4 2</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>1.2 4 2</size>
            </box>
          </geometry>

          <material>
            <ambient>0.3 0.3 0.3 1</ambient>
          </material>

        </visual>

      </link>

    </model>


    <model name="shelf_6">
      <static>true</static>

      <pose>5 3 1 0 0 0</pose>

      <link name="link">

        <collision name="collision">
          <geometry>
            <box>
              <size>1.2 4 2</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>1.2 4 2</size>
            </box>
          </geometry>

          <material>
            <ambient>0.3 0.3 0.3 1</ambient>
          </material>

        </visual>

      </link>

    </model>
      <!-- ========================= -->
    <!-- DYNAMIC OBSTACLE 1 -->
    <!-- ========================= -->

    <model name="dynamic_obstacle_1">

      <static>false</static>

      <!-- Start position -->
      <pose>-2 0 0.5 0 0 0</pose>

      <link name="base_link">

        <inertial>
          <mass>5.0</mass>
          <inertia>
            <ixx>0.1</ixx>
            <iyy>0.1</iyy>
            <izz>0.1</izz>
          </inertia>
        </inertial>

        <collision name="collision">
          <geometry>
            <box>
              <size>0.6 0.6 1.0</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>0.6 0.6 1.0</size>
            </box>
          </geometry>

          <material>
            <ambient>0.9 0.1 0.1 1</ambient>
          </material>
        </visual>

      </link>

      <plugin name="dynamic_obstacle_1_controller"
              filename="libgazebo_planar_move_plugin.so">

        <robot_namespace>/dynamic_obstacle_1</robot_namespace>

        <robot_frame>base_link</robot_frame>

        <odometry_frame>odom</odometry_frame>

        <odometry_topic>/dynamic_obstacle_1/odom</odometry_topic>

        <command_topic>/dynamic_obstacle_1/cmd_vel</command_topic>

        <control_mode>position</control_mode>

        <!-- We don't need obstacle TF/odometry -->
        <publish_odometry>false</publish_odometry>
        <publish_tf>false</publish_tf>
        <publish_imu>false</publish_imu>

        <ground_truth>true</ground_truth>

        <update_rate>50</update_rate>
        <publish_rate>30</publish_rate>

      </plugin>

    </model>

  </world>

</sdf>