<?xml version="1.0"?>

<robot name="custom_amr" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ========================= -->
  <!-- MATERIALS -->
  <!-- ========================= -->

  <material name="blue">
    <color rgba="0.1 0.3 0.8 1"/>
  </material>

  <material name="black">
    <color rgba="0.1 0.1 0.1 1"/>
  </material>

  <material name="gray">
    <color rgba="0.5 0.5 0.5 1"/>
  </material>

  <!-- ========================= -->
  <!-- BASE LINK -->
  <!-- ========================= -->

  <link name="base_link">

    <visual>
      <origin xyz="0 0 0.15"/>
      <geometry>
        <box size="0.6 0.45 0.20"/>
      </geometry>

      <material name="blue"/>
    </visual>

    <collision>
      <origin xyz="0 0 0.15"/>

      <geometry>
        <box size="0.6 0.45 0.20"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0.15"/>

      <mass value="10.0"/>

      <inertia
        ixx="0.2"
        ixy="0.0"
        ixz="0.0"
        iyy="0.3"
        iyz="0.0"
        izz="0.4"/>
    </inertial>

  </link>


  <!-- ========================= -->
  <!-- LEFT WHEEL -->
  <!-- ========================= -->

  <link name="left_wheel_link">

    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>

      <geometry>
        <cylinder radius="0.10" length="0.05"/>
      </geometry>

      <material name="black"/>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>

      <geometry>
        <cylinder radius="0.10" length="0.05"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="1.0"/>

      <inertia
        ixx="0.01"
        ixy="0.0"
        ixz="0.0"
        iyy="0.01"
        iyz="0.0"
        izz="0.01"/>
    </inertial>

  </link>


  <joint name="left_wheel_joint" type="continuous">

    <parent link="base_link"/>

    <child link="left_wheel_link"/>

    <origin xyz="0 0.25 0.10" rpy="0 0 0"/>

    <axis xyz="0 1 0"/>

  </joint>


  <!-- ========================= -->
  <!-- RIGHT WHEEL -->
  <!-- ========================= -->

  <link name="right_wheel_link">

    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>

      <geometry>
        <cylinder radius="0.10" length="0.05"/>
      </geometry>

      <material name="black"/>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>

      <geometry>
        <cylinder radius="0.10" length="0.05"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="1.0"/>

      <inertia
        ixx="0.01"
        ixy="0.0"
        ixz="0.0"
        iyy="0.01"
        iyz="0.0"
        izz="0.01"/>
    </inertial>

  </link>


  <joint name="right_wheel_joint" type="continuous">

    <parent link="base_link"/>

    <child link="right_wheel_link"/>

    <origin xyz="0 -0.25 0.10" rpy="0 0 0"/>

    <axis xyz="0 1 0"/>

  </joint>


  <!-- ========================= -->
  <!-- CASTER -->
  <!-- ========================= -->

  <link name="caster_link">

    <visual>

      <origin xyz="0 0 0"/>

      <geometry>
        <sphere radius="0.06"/>
      </geometry>

      <material name="gray"/>

    </visual>

    <collision>

      <origin xyz="0 0 0"/>

      <geometry>
        <sphere radius="0.06"/>
      </geometry>

    </collision>

    <inertial>

      <mass value="0.5"/>

      <inertia
        ixx="0.001"
        ixy="0"
        ixz="0"
        iyy="0.001"
        iyz="0"
        izz="0.001"/>

    </inertial>

  </link>


  <joint name="caster_joint" type="fixed">

    <parent link="base_link"/>

    <child link="caster_link"/>

    <origin xyz="-0.25 0 0.05"/>

  </joint>
  <!-- ========================= -->
  <!-- GAZEBO PHYSICS -->
  <!-- ========================= -->

  <gazebo reference="base_link">
    <material>Gazebo/Blue</material>
  </gazebo>

  <gazebo reference="left_wheel_link">
    <material>Gazebo/Black</material>
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
  </gazebo>

  <gazebo reference="right_wheel_link">
    <material>Gazebo/Black</material>
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
  </gazebo>

  <gazebo reference="caster_link">
    <material>Gazebo/Grey</material>
    <mu1>0.5</mu1>
    <mu2>0.5</mu2>
  </gazebo>

    <!-- ========================= -->
  <!-- DIFFERENTIAL DRIVE PLUGIN -->
  <!-- ========================= -->

  <gazebo>

    <plugin
      name="differential_drive_controller"
      filename="libgazebo_ros_diff_drive.so">

      <ros>
        <namespace>/</namespace>
      </ros>

      <!-- Wheel joints -->
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>

      <!-- Robot geometry -->
      <wheel_separation>0.50</wheel_separation>
      <wheel_diameter>0.20</wheel_diameter>

      <!-- Limits -->
      <max_wheel_torque>20.0</max_wheel_torque>
      <max_wheel_acceleration>5.0</max_wheel_acceleration>

      <!-- Odometry -->
      <odometry_source>world</odometry_source>

      <publish_odom>true</publish_odom>
      <publish_odom_tf>true</publish_odom_tf>
      <publish_wheel_tf>true</publish_wheel_tf>

      <!-- Frames -->
      <odometry_frame>odom</odometry_frame>
      <robot_base_frame>base_link</robot_base_frame>

      <!-- Topics -->
      <command_topic>cmd_vel</command_topic>
      <odometry_topic>odom</odometry_topic>

    </plugin>

  </gazebo>

</robot>